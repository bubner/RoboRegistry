{% extends "nav_layout.html.jinja" %}
{% block title %}
    Unregister '{{ event.name }}'
{% endblock title %}
{% block body %}
    <div class="centercontainer">
        <div class="bordered">
            <p class="headertext">Unregister from '{{ event.name }}'</p>
            <p class="mb-2">Are you sure you want to unregister from this event?</p>
            <form method="post"
                  action="{{ url_for('events.event_unregister', event_id=event.uid) }}">
                <input type="hidden" name="csrf_token" value="{{ csrf_token() }}" />
                <a href="{{ url_for('events.viewall') }}" class="btn btn-secondary">Cancel</a>
                <button type="submit" class="btn btn-danger">Unregister</button>
            </form>
        </div>
    </div>
{% endblock body %}
