{% extends "layout.html.jinja" %}
{% block title %}
    Scan QR
{% endblock title %}
{% block body %}
    <div class="container">
        <p class="headertext text-center mb-0">Event Check In</p>
        <h6 class="text-center">Scan QR Code</h6>
        <form method="post" action="{{ url_for('events.ci') }}">
            <input type="hidden" name="csrf_token" value="{{ csrf_token() }}" />
            <div class="form-group">
                <label for="event_url" class="form-label visually-hidden">Event URL</label>
                <input type="text"
                       class="form-control"
                       id="event_url"
                       name="event_url"
                       placeholder="https://roboregistry.app.bubner.me/events/ci/your-event-1234"
                       required />
            </div>
            <div id="reader" class="bg-white"></div>
            <div class="text-center mt-3">
                <a href="{{ url_for('auth.login') }}" class="btn btn-secondary">Cancel</a>
                <button type="submit" class="btn btn-success">Go</button>
            </div>
        </form>
    </div>
{% endblock body %}
{% block scripts %}
    <script src="{{ url_for('static', filename='libs/html5-qrcode.min.js') }}"></script>
    <script src="{{ url_for('static', filename='qr_man.js') }}"></script>
{% endblock scripts %}
