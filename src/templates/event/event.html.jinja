{% extends "nav_layout.html.jinja" %}
{% block title %}
    {{ event.name }}
{% endblock title %}
{% block body %}
    <div id="storer">
        <div class="maxtext dashheading">
            <p>{{ event.name }}</p>
            <h5>{{ event.uid }}</h5>
            {% if owned %}<h6>Event check-in code: {{ event.checkin_code }}</h6>{% endif %}
            {% if not registered and not owned and can_register %}
                <a href="{{ url_for('events.event_register', event_id=event.uid) }}"
                   class="btn btn-success">Register</a>
            {% elif registered and can_register %}
                <a href="{{ url_for('events.event_unregister', event_id=event.uid) }}"
                   class="btn btn-danger">Unregister</a>
            {% elif owned %}
                <a href="{{ url_for('events.manage', event_id=event.uid) }}"
                   class="btn btn-primary">Manage</a>
            {% endif %}
            {% if can_register %}
                <button id="copyregis" class="btn btn-secondary">Copy Registration Link</button>
                {% if owned %}<button id="copyci" class="btn btn-secondary">Copy Check-In Link</button>{% endif %}
            {% endif %}
            <hr />
        </div>
        <div class="container">
            <div class="row">
                <div class="col-md-6">
                    <div class="card sync mb-4 {% if is_running %}border-success{% elif not can_register %}border-danger{% else %}border-primary{% endif %}">
                        <div class="card-body">
                            <h5 class="card-title">
                                {% if is_running %}
                                    Event is running!
                                {% elif not can_register %}
                                    Event has ended!
                                {% else %}
                                    Time until event
                                {% endif %}
                            </h5>
                            <p class="card-text" id="relative-event-time">...</p>
                            <p id="event-time" class="mb-0">...</p>
                        </div>
                    </div>
                    <div class="card mb-5">
                        <div class="card-body">
                            <h5 class="card-title">Event Description</h5>
                            <pre class="card-text">{{ event.description }}</pre>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card mb-4">
                        <div class="card-body">
                            <h5 class="card-title">Event Details</h5>
                            <div class="card-text mb-3">
                                {{ team_regis_count }}{{ ' / ' + event.limit|string if event.limit != -1 else '' }}
                                team registration(s)
                                {% if event.registered|length != team_regis_count %}
                                    <div>{{ event.registered|length - team_regis_count }} other registration(s)</div>
                                {% endif %}
                            </div>
                            <div class="card-text mb-3">
                                <div>{{ event.date|strftime }}</div>
                                {{ event.start_time }}
                                to {{ event.end_time }} ({{ timezone }})
                            </div>
                            {% if event.email != "N/A" %}
                                <p class="card-text">
                                    Have inquiries? Contact: <b>{{ event.email }}</b>
                                </p>
                            {% endif %}
                        </div>
                    </div>
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">Location</h5>
                            <p class="card-text">{{ event.location }}</p>
                        </div>
                        <div id="map"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock body %}
{% block scripts %}
    <script src="https://api.mapbox.com/mapbox-gl-js/v2.3.1/mapbox-gl-csp.js"></script>
    <link href='https://api.mapbox.com/mapbox-gl-js/v2.3.1/mapbox-gl.css'
          rel='stylesheet' />
    <script defer nonce="{{ csp_nonce() }}">
        const MAPBOX_WORKER = "{{ url_for('static', filename='libs/mapbox-gl-csp-worker_v2.3.1.js') }}";
        const MAPBOX_API_KEY = "{{ mapbox_api_key }}";
        const EVENT_LOCATION = "{{ event.location }}";
        const EVENT_DATE = "{{ event.date }}";
        const EVENT_START_TIME = "{{ event.start_time }}";
        const EVENT_END_TIME = "{{ event.end_time }}";
        const OFFSET = "{{ offset }}";

        function copyToClipboard(url) {
            navigator.clipboard.writeText(url);
            alert(`Copied to clipboard: ${url}`);
        }

        document.getElementById('copyregis').addEventListener('click', () => {
            const url = `https://roboregistry.app.bubner.me/events/register/${"{{ event.uid }}"}`;
            copyToClipboard(url);
        });

        document.getElementById('copyci').addEventListener('click', () => {
            const url = `https://roboregistry.app.bubner.me/events/ci/${"{{ event.uid }}"}`;
            copyToClipboard(url);
        });
    </script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/dompurify/3.0.5/purify.min.js"
            integrity="sha512-KqUc2WMPF/gxte9xVjVE4TIt1LMUTidO3BrcItFg0Ro24I7pGNzgcXdnWdezNY+8T0/JEmdC79MuwYn+8UdOqw=="
            crossorigin="anonymous"
            referrerpolicy="no-referrer"></script>
    <script src="{{ url_for('static', filename='libs/humanize-duration.min.js') }}"></script>
    <script src="{{ url_for('static', filename='mapbox_marker.js') }}"></script>
    <script src="{{ url_for('static', filename='event_viewer.js') }}"></script>
{% endblock scripts %}
