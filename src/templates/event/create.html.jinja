{% extends "nav_layout.html.jinja" %}
{% block title %}
    Create Event
{% endblock title %}
{% block body %}
    <div class="centercontainer">
        <div>
            <form method="post" action="{{ url_for('events.create') }}">
                <div class="bordered p-4">
                    <p class="headertext">Create a new event</p>
                    <div class="row">
                        <div class="col-md-6">
                            <input type="hidden" name="csrf_token" value="{{ csrf_token() }}" />
                            <div class="form-group">
                                <label for="event_name">Event Name</label>
                                <span aria-hidden="true" class="text-danger">*</span>
                                <input type="text"
                                       class="form-control"
                                       id="event_name"
                                       name="event_name"
                                       value="{{ old_data.name }}"
                                       maxlength="32"
                                       required />
                            </div>
                            <div class="form-group mt-2">
                                <label for="event_date">Event Date</label>
                                <span aria-hidden="true" class="text-danger">*</span>
                                <input type="date"
                                       class="form-control"
                                       id="event_date"
                                       name="event_date"
                                       value="{{ old_data.date }}"
                                       required />
                            </div>
                            <div class="form-group mt-2">
                                <label for="event_start_time">Event Start Time</label>
                                <span aria-hidden="true" class="text-danger">*</span>
                                <input type="time"
                                       class="form-control"
                                       id="event_start_time"
                                       name="event_start_time"
                                       value="{{ old_data.start_time }}"
                                       required />
                            </div>
                            <div class="form-group mt-2">
                                <label for="event_end_time">Event End Time</label>
                                <span aria-hidden="true" class="text-danger">*</span>
                                <input type="time"
                                       class="form-control"
                                       id="event_end_time"
                                       name="event_end_time"
                                       value="{{ old_data.end_time }}"
                                       required />
                            </div>
                            <div class="form-group mt-2">
                                <label for="event_timezone">Timezone</label>
                                <span aria-hidden="true" class="text-danger">*</span>
                                <select class="form-control"
                                        id="event_timezone"
                                        name="event_timezone"
                                        required>
                                    {% for tz in timezones %}
                                        <option value="{{ tz }}" {{ "selected" if tz==old_data.timezone else '' }}>{{ tz }}
                                        </option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="form-group mt-2">
                                <label for="event_limit" class="d-flex flex-column">
                                    <span>Maximum number of FIRST® club registrations</span>
                                    <small class="text-muted">Leave blank to uncap, only applies to FIRST® clubs that register</small>
                                </label>
                                <input type="number"
                                       class="form-control"
                                       id="event_limit"
                                       name="event_limit"
                                       min="1"
                                       max="999"
                                       value="{{ old_data.limit if old_data.limit != -1 else '' }}" />
                            </div>
                            <div class="form-group mb-4 mt-2">
                                <label for="event_description">Event Description</label>
                                <span aria-hidden="true" class="text-danger">*</span>
                                <textarea class="form-control"
                                          id="event_description"
                                          name="event_description"
                                          rows="3"
                                          required>{{ old_data.description }}</textarea>
                            </div>
                        </div>
                        <div class="col-md-6 mb-4">
                            <div class="form-group">
                                {% if error %}
                                    <div class="alert alert-danger" role="alert">{{ error }}</div>
                                {% endif %}
                                <div class="form-group form-check">
                                    <input type="checkbox"
                                           class="form-check-input"
                                           id="display_email"
                                           name="display_email"
                                           {% if old_data.email != "N/A" %}checked{% endif %} />
                                    <label class="form-check-label" for="display_email">Display your email with the event?</label>
                                    <p class="text-muted" id="disablewarn">
                                        People registering through
                                        RoboRegistry will not be able to see your email address for contact.
                                    </p>
                                </div>
                                <label for="email">Display email</label>
                                <input class="form-control"
                                       id="email"
                                       name="event_email"
                                       placeholder="{{ user.email }}"
                                       value="{{ old_data.email if old_data.email != 'N/A' }}"
                                       type="email"
                                       autocomplete="username" />
                            </div>
                            <div class="form-group mt-2">
                                <label for="event_location">Event Location</label>
                                <span aria-hidden="true" class="text-danger">*</span>
                                <input type="text"
                                       class="form-control"
                                       id="event_location"
                                       name="event_location"
                                       required
                                       value="{{ old_data.location or '' }}" />
                            </div>
                            <div id="map" class="rounded"></div>
                        </div>
                        <div>
                            <a class="btn btn-secondary" href="{{ url_for('dashboard') }}">Cancel</a>
                            <button type="submit" class="btn btn-primary">Create Event</button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
{% endblock body %}
{% block scripts %}
    <script src="https://api.mapbox.com/mapbox-gl-js/v2.3.1/mapbox-gl-csp.js"></script>
    <link href="https://api.mapbox.com/mapbox-gl-js/v2.3.1/mapbox-gl.css"
          rel="stylesheet" />
    <script nonce="{{ csp_nonce() }}">
        const MAPBOX_WORKER = "{{ url_for('static', filename='libs/mapbox-gl-csp-worker_v2.3.1.js') }}";
        const MAPBOX_API_KEY = "{{ mapbox_api_key }}";
        const OLD_DATA_TIMEZONE = "{{ old_data.timezone }}";
    </script>
    <script src="{{ url_for('static', filename='event_creator.js') }}"></script>
{% endblock scripts %}
