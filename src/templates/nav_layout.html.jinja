{% extends "layout.html.jinja" %}
{% block navbar %}
    <nav class="navbar navbar-expand-lg navbar-light {{ 'bg-dark' if request.cookies.get("darkmode") == 'on' else 'bg-light' }}">
        <div class="container-fluid">
            <a class="navbar-brand" href="{{ url_for('dashboard') }}">
                <img src="{{ url_for('static', filename='assets/rr.png') }}"
                     alt="RoboRegistry"
                     width="100"
                     height="100"
                     id="brand" />
            </a>
            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarNav"
                    aria-controls="navbarNav"
                    aria-expanded="false"
                    aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link" href="{{ url_for('events.create') }}">➕ Create an event</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ url_for('events.viewall') }}">🔎 View your events</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ url_for('events.ci') }}">📒 Check-in to an event</a>
                    </li>
                </ul>
                <ul class="navbar-nav">
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle"
                           href="#"
                           id="navbarDropdown"
                           role="button"
                           data-bs-toggle="dropdown"
                           aria-expanded="false">
                            <svg data-jdenticon-value="{{ user.first_name }} {{ user.last_name }}"
                                 width="40"
                                 height="40"
                                 id="pfp">
                            </svg>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end"
                            aria-labelledby="navbarDropdown">
                            <li id="loggedinas">
                                Logged in as <b>{{ user.email }}</b>
                            </li>
                            <li>
                                <a class="dropdown-item" href="{{ url_for('about') }}">📖 About</a>
                            </li>
                            <li>
                                <a class="dropdown-item" href="{{ url_for('settings') }}">⚙️ Settings</a>
                            </li>
                            <li>
                                <a class="dropdown-item" href="{{ url_for('auth.logout') }}">👋 Log out</a>
                            </li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
{% endblock navbar %}
