{% extends "layout.html.jinja" %}
{% block title %}
    Login
{% endblock title %}
{% block body %}
    <div class="centercontainer">
        <div class="border-top border-bottom rounded">
            <div class="row">
                <div class="col-md-6 text-center d-flex justify-content-center flex-column">
                    <img src="{{ url_for('static', filename='assets/rr.png') }}"
                         id="logoimg"
                         width="100"
                         height="100"
                         alt="RoboRegistry" />
                    <div class="alert alert-primary mb-2 mt-3" role="alert">
                        At an event? <a href="{{ url_for('events.ci') }}">Check in here</a>
                    </div>
                    <div class="col-md-12 text-center">
                        {% with messages = get_flashed_messages(with_categories=True) %}
                            {% if messages %}
                                {% for message in messages %}
                                    {% if message[0] == 'success' %}
                                        <div class="alert alert-success" role="alert">
                                        {% else %}
                                            <div class="alert alert-warning" role="alert">
                                            {% endif %}
                                            {{ message[1] }}
                                        </div>
                                    {% endfor %}
                                {% endif %}
                            {% endwith %}
                        </div>
                    </div>
                    <div class="col-md-6">
                        <form action="{{ url_for('auth.login') }}"
                              method="post"
                              class="text-center py-5">
                            <input type="hidden" name="csrf_token" value="{{ csrf_token() }}" />
                            <h6>Log into RoboRegistry</h6>
                            {% if error %}<div class="alert alert-danger" role="alert">{{ error }}</div>{% endif %}
                            <div class="mb-2">
                                <label for="email" class="form-label visually-hidden">Email</label>
                                <input class="form-control mx-auto w-auto"
                                       id="email"
                                       name="email"
                                       placeholder="Email"
                                       type="email"
                                       required
                                       autocomplete="username" />
                            </div>
                            <div class="mb-3">
                                <label for="password" class="form-label visually-hidden">Password</label>
                                <input class="form-control mx-auto w-auto"
                                       id="password"
                                       name="password"
                                       placeholder="Password"
                                       autocomplete="current-password"
                                       required
                                       type="password" />
                            </div>
                            <div class="mb-3">
                                <input type="checkbox"
                                       class="form-check-input"
                                       id="remember-me"
                                       name="remember-me" />
                                <label class="form-check-label" for="remember-me">&nbsp; Remember me</label>
                            </div>
                            <div class="mb-3">
                                <a href="{{ url_for('auth.forgotpassword') }}">Forgot password?</a>
                            </div>
                            <div class="mb-3">
                                <button class="btn btn-success w-100" type="submit">Log in</button>
                            </div>
                            <p class="mt-3">
                                No account? <a href="{{ url_for('auth.register') }}">Register</a>, or:
                            </p>
                            <a href="{{ url_for('auth.googleauth') }}" id="google">Continue with Google</a>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock body %}
{% block scripts %}
    <script nonce="{{ csp_nonce() }}">
        // Set dark mode cookie if user has dark mode preference
        if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches && !document.cookie.includes("darkmode")) {
            const date = new Date();
            date.setTime(date.getTime() + (365 * 24 * 60 * 60 * 1000));
            const oneYear = date.toUTCString();
            document.cookie = "darkmode=on;path=/;SameSite=Strict;Secure;expires=" + oneYear;
            window.location.reload();
        }
    </script>
{% endblock scripts %}
