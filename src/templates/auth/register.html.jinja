{% extends "layout.html.jinja" %}
{% block title %}
    Register
{% endblock title %}
{% block body %}
    <div class="centercontainer">
        <div class="border-bottom rounded">
            <img src="{{ url_for('static', filename='assets/rr.png') }}"
                 id="logoimgr"
                 width="100"
                 height="100"
                 alt="RoboRegistry" />
            <form action="{{ url_for('auth.register') }}"
                  method="post"
                  class="text-center py-5">
                <input type="hidden" name="csrf_token" value="{{ csrf_token() }}" />
                <div class="mb-4 alert alert-secondary">
                    Already have an account? <a href="{{ url_for('auth.login') }}">Login here</a>
                    <hr />
                    Looking to check in at an event? <a href="{{ url_for('events.ci') }}">Check in here</a>
                </div>
                <h6>You are creating a new RoboRegistry account.</h6>
                {% if error %}<div class="alert alert-danger" role="alert">{{ error }}</div>{% endif %}
                <div class="mb-2">
                    <label for="email" class="form-label visually-hidden">Email</label>
                    <input class="form-control mx-auto w-auto"
                           id="email"
                           name="email"
                           placeholder="Email"
                           required
                           type="email" />
                </div>
                <div class="mb-3">
                    <label for="password" class="form-label visually-hidden">Password</label>
                    <input class="form-control mx-auto w-auto"
                           id="password"
                           name="password"
                           placeholder="Password"
                           required
                           type="password" />
                </div>
                <div class="mb-3">
                    <input type="checkbox"
                           class="form-check-input"
                           id="remember-me"
                           name="remember-me" />
                    <label class="form-check-label" for="remember-me">&nbsp; Remember me</label>
                </div>
                <div class="d-flex justify-content-center gap-2 align-items-center">
                    <button class="btn btn-primary" type="submit">Register</button>
                    <h6 class="p-2">or</h6>
                    <a href="{{ url_for('auth.googleauth') }}" id="google">Continue with Google</a>
                </div>
            </form>
        </div>
    </div>
{% endblock body %}
