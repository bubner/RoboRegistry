{% extends "layout.html.jinja" %}
{% block title %}
     About
{% endblock title %}
{% block body %}
     <div class="centercontainer">
          <div class="bordered">
               <p class="headertext">About RoboRegistry</p>
               <img src="{{ url_for('static', filename='assets/favicon.ico') }}"
                    alt="logo"
                    width="80"
                    height="80"
                    class="mb-4" />
               <p class="text-center limit-w">
                    RoboRegistry is a web application designed to make FLL/FTC/FRC scrimmage and event
                    management easier. Manually collecting data on event attendance for scrimmages can be a stressful
                    and overly complex task, and it is our goal is to minimise that complexity as much as possible.
               </p>
               <div class="infogrid mb-3">
                    <img class="imglink"
                         title="Python 3.9"
                         alt="Python 3.9"
                         width="auto"
                         height="auto"
                         src="{{ url_for('static', filename='assets/py.png') }}" />
                    <img class="imglink"
                         title="Firebase"
                         alt="Firebase"
                         width="auto"
                         height="auto"
                         src="{{ url_for('static', filename='assets/fb.svg') }}" />
                    <img class="imglink"
                         title="Vercel"
                         alt="Vercel"
                         width="auto"
                         height="auto"
                         src="{{ url_for('static', filename='assets/ve.svg') }}" />
                    <img class="imglink"
                         title="Flask"
                         alt="Flask"
                         width="auto"
                         height="auto"
                         src="{{ url_for('static', filename='assets/fl.png') }}" />
                    <img class="imglink"
                         title="Jinja"
                         alt="Jinja"
                         width="auto"
                         height="auto"
                         src="{{ url_for('static', filename='assets/ji.png') }}" />
                    <img class="imglink"
                         title="Bootstrap 5"
                         alt="Bootstrap 5"
                         width="auto"
                         height="auto"
                         src="{{ url_for('static', filename='assets/bs.svg') }}" />
               </div>
               <p>
                    Developed by <a href="https://bubner.me" target="_blank">Lucas Bubner</a>, 2023. View the source code <a href="https://github.com/bubner/RoboRegistry" target="_blank">here</a>.
               </p>
               <div class="container text-center">
                    <a href="{{ url_for('dashboard') }}" class="btn btn-secondary">Go to dashboard</a>
                    <a href="{{ url_for('privacy') }}" class="btn btn-success">Privacy Policy</a>
               </div>
          </div>
     </div>
{% endblock body %}
{% block scripts %}
     <script defer nonce="{{ csp_nonce() }}">
         const links = [
             "https://github.com/bubner/RoboRegistry",
             "https://www.python.org/",
             "https://firebase.google.com/",
             "https://vercel.com/",
             "https://flask.palletsprojects.com/en/2.3.x/",
             "https://jinja.palletsprojects.com/en/3.1.x/",
             "https://getbootstrap.com/"
         ];
         const imgs = document.querySelectorAll(".imglink");
         for (let i = 0; i < imgs.length; i++) {
             imgs[i].addEventListener("click", () => {
                 window.open(links[i], "_blank");
             });
         }
     </script>
{% endblock scripts %}
